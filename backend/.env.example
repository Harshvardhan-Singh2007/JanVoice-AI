NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
# Optional; image uploads are unavailable until all Cloudinary values are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to the exact number of trusted reverse-proxy hops in your deployment.
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
GEMINI_RATE_LIMIT_WINDOW_MS=60000
GEMINI_RATE_LIMIT_MAX=20
IMAGE_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
IMAGE_UPLOAD_RATE_LIMIT_MAX=20
DUPLICATE_CHECK_RATE_LIMIT_WINDOW_MS=60000
DUPLICATE_CHECK_RATE_LIMIT_MAX=30
